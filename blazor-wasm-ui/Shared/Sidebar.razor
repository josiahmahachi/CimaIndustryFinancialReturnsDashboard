@* Sidebar navigation component - aligns with React Sidebar.tsx implementation *@
@using blazor_wasm_ui.Components.UI

<nav class="@(IsCollapsed ? "w-16" : "w-64") bg-card border-r border-border h-screen fixed left-0 top-0 transition-all duration-300 ease-in-out">
    <!-- Logo/Header -->
    <div class="@(IsCollapsed ? "px-4" : "px-6") py-4 border-b border-border relative">
        <div class="flex items-center">
            <div class="flex items-center space-x-3">
                <Icon Name="Building2" Size="base" Class="text-foreground flex-shrink-0" />
                @if (!IsCollapsed)
                {
                    <span class="text-lg text-foreground">Financial Authority</span>
                }
            </div>
            <button
                @onclick="@(async () => await OnToggleCollapse.InvokeAsync())"
                class="absolute right-4 top-1/2 transform -translate-y-1/2 p-1 rounded-md hover:bg-muted transition-colors"
                aria-label="@(IsCollapsed ? "Expand sidebar" : "Collapse sidebar")"
            >
                @if (IsCollapsed)
                {
                    <Icon Name="ChevronRight" Size="sm" Class="text-muted-foreground" />
                }
                else
                {
                    <Icon Name="ChevronLeft" Size="sm" Class="text-muted-foreground" />
                }
            </button>
        </div>
    </div>

    <!-- Navigation Menu -->
    <div class="py-4">
        <ul class="space-y-1">
            @foreach (var item in MenuItems)
            {
                var isActive = ActiveItem.ToLower() == item.Id;
                <li>
                    <button
                        @onclick="@(async () => await OnItemClick.InvokeAsync(item.Id))"
                        class="@GetMenuItemClass(isActive)"
                        title="@(IsCollapsed ? item.Label : "")"
                    >
                        @if (!IsCollapsed)
                        {
                            <Icon Name="@item.IconName" Size="xs" Class="flex-shrink-0" WithMargin="true" />
                        }
                        else
                        {
                            <Icon Name="@item.IconName" Size="xs" Class="flex-shrink-0" />
                        }
                        @if (!IsCollapsed)
                        {
                            <span class="transition-opacity duration-200">@item.Label</span>
                        }
                        @if (IsCollapsed)
                        {
                            <div class="absolute left-full ml-2 px-2 py-1 bg-primary text-primary-foreground text-xs rounded opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 whitespace-nowrap z-50">
                                @item.Label
                            </div>
                        }
                    </button>
                </li>
            }
        </ul>
    </div>
</nav>

@code {
    /// <summary>
    /// Menu item data class
    /// </summary>
    private class MenuItem
    {
        required public string IconName { get; set; }
        required public string Label { get; set; }
        required public string Id { get; set; }
    }

    /// <summary>
    /// Menu items matching React version with lucide icon names
    /// </summary>
    private List<MenuItem> MenuItems = new()
    {
        new MenuItem { IconName = "Home", Label = "Home", Id = "home" },
        new MenuItem { IconName = "FileText", Label = "Filings & Extensions", Id = "filings" },
        new MenuItem { IconName = "Send", Label = "Requests", Id = "requests" },
        new MenuItem { IconName = "ClipboardList", Label = "Applications", Id = "applications" },
        new MenuItem { IconName = "Users", Label = "User Management", Id = "user-management" },
        new MenuItem { IconName = "Settings", Label = "Settings", Id = "settings" },
        new MenuItem { IconName = "Book", Label = "Documentation", Id = "documentation" },
        new MenuItem { IconName = "LifeBuoy", Label = "Support", Id = "support" },
    };

    /// <summary>
    /// Generate CSS class for menu item
    /// </summary>
    private string GetMenuItemClass(bool isActive)
    {
        var baseClass = "w-full flex items-center ";
        var paddingClass = IsCollapsed ? "px-4 justify-center " : "px-6 ";
        var stateClass = "py-3 text-sm cursor-pointer transition-colors group relative ";
        var colorClass = isActive
            ? "text-primary-foreground bg-primary border-r-2 border-primary"
            : "text-muted-foreground hover:bg-muted hover:text-foreground";

        return baseClass + paddingClass + stateClass + colorClass;
    }

    /// <summary>
    /// The currently active menu item
    /// </summary>
    [Parameter]
    public string ActiveItem { get; set; } = "filings";

    /// <summary>
    /// Whether sidebar is in collapsed state
    /// </summary>
    [Parameter]
    public bool IsCollapsed { get; set; } = false;

    /// <summary>
    /// Callback when a menu item is clicked
    /// </summary>
    [Parameter]
    public EventCallback<string> OnItemClick { get; set; }

    /// <summary>
    /// Callback when sidebar collapse toggle is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnToggleCollapse { get; set; }
}
