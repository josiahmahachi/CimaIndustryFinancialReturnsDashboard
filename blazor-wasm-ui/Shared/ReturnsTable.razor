@* Returns Table - Data Grid with Pagination *@
@using blazor_wasm_ui.Models
@using blazor_wasm_ui.Services
@using blazor_wasm_ui.Components.UI
@inject NavigationService NavigationService
@inject FormStateService FormStateService
@inject IReturnsDataService ReturnsDataService

<div class="bg-white rounded-lg border border-neutral-200 shadow-sm">
    <div class="px-6 py-4 border-b border-neutral-200">
        <h2 class="text-xl text-neutral-900">Your Financial Returns</h2>
        <p class="text-sm text-neutral-600 mt-1">
            Returns eligible for extension requests are highlighted below.
        </p>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-neutral-50 border-b border-neutral-200">
                <tr>
                    <th class="px-6 py-3 text-left text-xs text-neutral-500 uppercase tracking-wider">Filing ID</th>
                    <th class="px-6 py-3 text-left text-xs text-neutral-500 uppercase tracking-wider">Entity Details</th>
                    <th class="px-6 py-3 text-left text-xs text-neutral-500 uppercase tracking-wider">Period</th>
                    <th class="px-6 py-3 text-left text-xs text-neutral-500 uppercase tracking-wider">Due Date</th>
                    <th class="px-6 py-3 text-left text-xs text-neutral-500 uppercase tracking-wider">Filing Status</th>
                    <th class="px-6 py-3 text-left text-xs text-neutral-500 uppercase tracking-wider">Extensions</th>
                    <th class="px-6 py-3 text-left text-xs text-neutral-500 uppercase tracking-wider">Extension Status</th>
                    <th class="px-6 py-3 text-left text-xs text-neutral-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-neutral-200">
                @if (Returns != null && Returns.Count > 0)
                {
                    @foreach (var returnItem in GetSortedReturns(Returns))
                    {
                        <tr class="hover:bg-neutral-50 @(returnItem.Status == ReturnStatus.Outstanding ? "bg-neutral-50" : "")">
                            <td class="px-6 py-4">
                                <div class="text-sm text-neutral-900">@returnItem.Id.PadLeft(6, '0')</div>
                            </td>
                            <td class="px-6 py-4">
                                <div>
                                    <div class="text-sm text-neutral-900">
                                        @{
                                            var displayName = returnItem.FundName;
                                            if (returnItem.FundType == FundType.MutualFund && !string.IsNullOrEmpty(returnItem.ParentFundName))
                                            {
                                                displayName = $"{returnItem.FundName} ({returnItem.ParentFundName})";
                                            }
                                        }
                                        @displayName
                                    </div>
                                    <div class="text-xs text-neutral-500">
                                        Entity ID: @returnItem.EntityId.PadLeft(6, '0')
                                    </div>
                                    <div class="text-xs text-neutral-500">
                                        @returnItem.FundType.ToString().Replace("MutualFund", "Mutual Fund").Replace("PrivateFund", "Private Fund")
                                        @if (returnItem.FundStructure.HasValue)
                                        {
                                            <span class="ml-1">• @returnItem.FundStructure.Value.ToString()</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-neutral-900">@returnItem.PeriodDescription</div>
                                <div class="text-xs text-neutral-500">@returnItem.Period</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-neutral-900">@returnItem.DueDate</div>
                                <div class="text-xs text-neutral-600">
                                    @if (returnItem.Status == ReturnStatus.Outstanding)
                                    {
                                        <text>91 days past filing due date</text>
                                    }
                                    else
                                    {
                                        @returnItem.DueDateDescription
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex px-2 py-1 text-xs rounded-full @GetStatusBadgeClass(returnItem.Status)">
                                    @returnItem.Status.ToString().Replace("Available", "Available")
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-neutral-900">
                                    @returnItem.ExtensionsUsed of @returnItem.MaxExtensions used
                                </div>
                                <div class="text-xs text-neutral-500">@returnItem.ExtensionDescription</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-neutral-900">
                                    @if (returnItem.ExtensionsUsed == 0)
                                    {
                                        <text>No Extension</text>
                                    }
                                    else if (returnItem.Status == ReturnStatus.UnderReview)
                                    {
                                        <text>Under Review</text>
                                    }
                                    else if (returnItem.Status == ReturnStatus.Processed)
                                    {
                                        <text>Extension Approved</text>
                                    }
                                    else if (returnItem.ExtensionsUsed == returnItem.MaxExtensions)
                                    {
                                        <text>Max Extensions Used</text>
                                    }
                                    else
                                    {
                                        <text>Extension Active</text>
                                    }
                                </div>
                                <div class="text-xs text-neutral-500">
                                    @if (returnItem.ExtensionsUsed == 0)
                                    {
                                        <text>No extension requested</text>
                                    }
                                    else if (returnItem.Status == ReturnStatus.UnderReview)
                                    {
                                        <text>Extension pending approval</text>
                                    }
                                    else if (returnItem.Status == ReturnStatus.Processed)
                                    {
                                        <text>Extension was granted</text>
                                    }
                                    else if (returnItem.ExtensionsUsed == returnItem.MaxExtensions)
                                    {
                                        <text>All extensions utilized</text>
                                    }
                                    else
                                    {
                                        <text>@returnItem.UsedExtensionDays days extension active</text>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex gap-2">
                                    @{
                                        var buttons = GetActionButtonsForReturn(returnItem);
                                        @foreach (var button in buttons)
                                        {
                                            <Button 
                                                Variant="@button.Variant" 
                                                Size="sm"
                                                OnClick="@button.OnClick">
                                                @button.Text
                                            </Button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="px-6 py-8 text-center text-neutral-600">
                            No filings found. Try adjusting your filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

    <div class="px-6 py-4 border-t border-neutral-200">
        <div class="flex items-center justify-between">
            <div class="text-sm text-neutral-500">Showing @((CurrentPage - 1) * 12 + 1) to @Math.Min(CurrentPage * 12, TotalReturns) of @TotalReturns returns</div>
            <div class="flex space-x-2">
                <button type="button" class="px-3 py-1 text-sm text-neutral-500 bg-white border border-neutral-300 rounded disabled:opacity-50 disabled:cursor-not-allowed" disabled="@(CurrentPage <= 1)" @onclick="@(() => OnPrevPage.InvokeAsync(null))">
                    ←
                </button>
                @for (int i = 1; i <= TotalPages; i++)
                {
                    var pageNum = i;
                    <button
                        type="button"
                        class="px-3 py-1 text-sm text-neutral-600 bg-white border border-neutral-300 rounded @(CurrentPage == pageNum ? "bg-neutral-900 text-white border-neutral-900" : "hover:bg-neutral-100")"
                        @onclick="@(() => OnGoToPage.InvokeAsync(pageNum))">
                        @pageNum
                    </button>
                }
                <button type="button" class="px-3 py-1 text-sm text-neutral-500 bg-white border border-neutral-300 rounded disabled:opacity-50 disabled:cursor-not-allowed" disabled="@(CurrentPage >= TotalPages)" @onclick="@(() => OnNextPage.InvokeAsync(null))">
                    →
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public List<FinancialReturn> Returns { get; set; } = new();

    [Parameter]
    public int TotalReturns { get; set; }

    [Parameter]
    public int CurrentPage { get; set; } = 1;

    [Parameter]
    public int TotalPages { get; set; } = 1;

    [Parameter]
    public EventCallback OnNextPage { get; set; }

    [Parameter]
    public EventCallback OnPrevPage { get; set; }

    [Parameter]
    public EventCallback<int> OnGoToPage { get; set; }

    [Parameter]
    public EventCallback<string> OnViewReturn { get; set; }

    [Parameter]
    public EventCallback<string> OnViewExtension { get; set; }

    [Parameter]
    public EventCallback<string> OnFileReturn { get; set; }

    [Parameter]
    public EventCallback<string> OnRequestUnlock { get; set; }

    [Parameter]
    public EventCallback<string> OnRequestExtension { get; set; }

    [Parameter]
    public string ActiveTab { get; set; } = "active";

    /// <summary>
    /// Sort returns so that canRequestExtension=true items appear first
    /// </summary>
    private List<FinancialReturn> GetSortedReturns(List<FinancialReturn> returns)
    {
        return returns
            .OrderByDescending(r => r.CanRequestExtension)
            .ToList();
    }

    /// <summary>
    /// Get status badge styling using semantic tokens
    /// </summary>
    private string GetStatusBadgeClass(ReturnStatus status) => status switch
    {
        ReturnStatus.Available => "bg-status-available text-status-available-foreground",
        ReturnStatus.Prepared => "bg-status-prepared text-status-prepared-foreground",
        ReturnStatus.ReadyToSubmit => "bg-status-ready text-status-ready-foreground",
        ReturnStatus.Processed => "bg-status-processed text-status-processed-foreground",
        ReturnStatus.Returned => "bg-status-returned text-status-returned-foreground",
        ReturnStatus.Waived => "bg-status-waived text-status-waived-foreground",
        ReturnStatus.Outstanding => "bg-status-outstanding text-status-outstanding-foreground",
        ReturnStatus.Deferred => "bg-status-deferred text-status-deferred-foreground",
        _ => "bg-status-available text-status-available-foreground"
    };

    /// <summary>
    /// Render action buttons matching React implementation exactly
    /// </summary>
    private List<(string Text, string Variant, Func<Task> OnClick)> GetActionButtonsForReturn(FinancialReturn returnItem)
    {
        var buttons = new List<(string Text, string Variant, Func<Task> OnClick)>();

        // Check if there's a pending request
        if (returnItem.PendingRequestType.HasValue && returnItem.PendingRequestStatus == PendingRequestStatus.Pending)
        {
            var buttonText = returnItem.PendingRequestType.Value == PendingRequestType.Extension
                ? "View Extension"
                : returnItem.PendingRequestType.Value == PendingRequestType.Waiver
                ? "View Waiver"
                : "View Deferral";

            buttons.Add(("File Return", "success", () => OnFileReturn.InvokeAsync(returnItem.Id)));
            buttons.Add((buttonText, "secondary", () => OnViewExtension.InvokeAsync(returnItem.Id)));
            return buttons;
        }

        // Filed returns: Show View Return and View Extension (if extension was used)
        if (returnItem.Status == ReturnStatus.Processed)
        {
            buttons.Add(("View Return", "secondary", () => OnViewReturn.InvokeAsync(returnItem.Id)));
            if (returnItem.ExtensionsUsed > 0)
            {
                buttons.Add(("View Extension", "secondary", () => OnViewExtension.InvokeAsync(returnItem.Id)));
            }
            return buttons;
        }

        // Under Review: Show View Extension button
        if (returnItem.Status == ReturnStatus.UnderReview)
        {
            buttons.Add(("View Extension", "secondary", () => OnViewExtension.InvokeAsync(returnItem.Id)));
            return buttons;
        }

        // Returns that can't request extension
        if (!returnItem.CanRequestExtension)
        {
            if (returnItem.Status == ReturnStatus.Outstanding)
            {
                buttons.Add(("Unlock Filing Row", "destructive", () => OnRequestUnlock.InvokeAsync(returnItem.Id)));
                buttons.Add(("Request Extension/Waiver", "primary", () => OnRequestExtension.InvokeAsync(returnItem.Id)));
            }
            else
            {
                buttons.Add(("File Return", "success", () => OnFileReturn.InvokeAsync(returnItem.Id)));
            }
            return buttons;
        }

        // Pending/Overdue returns: Show Request Extension and File Return
        if (returnItem.Status == ReturnStatus.Outstanding)
        {
            buttons.Add(("Unlock Filing Row", "destructive", () => OnRequestUnlock.InvokeAsync(returnItem.Id)));
            buttons.Add(("Request Extension/Waiver", "primary", () => OnRequestExtension.InvokeAsync(returnItem.Id)));
        }
        else
        {
            buttons.Add(("File Return", "success", () => OnFileReturn.InvokeAsync(returnItem.Id)));
            var variant = returnItem.IsUrgent ? "destructive" : "primary";
            buttons.Add(("Request Extension/Waiver", variant, () => OnRequestExtension.InvokeAsync(returnItem.Id)));
        }

        return buttons;
    }

    private async Task NavigateToExtensionRequest(string returnId)
    {
        var returnData = await ReturnsDataService.GetReturnByIdAsync(returnId);
        if (returnData != null)
        {
            FormStateService.StartExtensionRequest(returnData);
            NavigationService.NavigateToExtensionRequest(returnId);
        }
    }

    private async Task NavigateToUnlockRequest(string returnId)
    {
        var returnData = await ReturnsDataService.GetReturnByIdAsync(returnId);
        if (returnData != null)
        {
            FormStateService.StartUnlockRequest(returnData);
            NavigationService.NavigateToUnlockRequest(returnId);
        }
    }
}
