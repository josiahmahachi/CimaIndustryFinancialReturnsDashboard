@page "/payment/{id}"
@using blazor_wasm_ui.Models
@using blazor_wasm_ui.Services
@using blazor_wasm_ui.Components

<div class="w-full min-h-screen bg-neutral-50">
    <div class="px-6 py-8 max-w-4xl mx-auto">
        @if (Loading)
        {
            <div class="text-center py-12">
                <p class="text-neutral-600">Loading payment details...</p>
            </div>
        }
        else if (ReturnData == null)
        {
            <div class="bg-white border border-red-200 rounded-lg p-6 text-center">
                <p class="text-red-700 font-medium mb-4">Filing not found</p>
                <p class="text-neutral-600 mb-4">The filing information could not be loaded.</p>
                <button
                    @onclick="@HandleBack"
                    class="btn btn-primary">
                    Back to Filings
                </button>
            </div>
        }
        else
        {
            <!-- Breadcrumb -->
            <Breadcrumb Items="BreadcrumbItems" />

            <!-- Header -->
            <div class="mb-8">
                <div class="flex items-center justify-between mb-4">
                    <button @onclick="HandleBack" class="btn btn-secondary px-4 py-2 text-sm">
                        ← Back to Request Details
                    </button>
                </div>

                <div class="mb-6">
                    <ProgressIndicator CurrentStep="2" Steps="Steps" SkipPayment="ShouldSkipPayment()" />
                </div>

                <h1 class="text-3xl text-neutral-900 mb-2">Payment</h1>
                <p class="text-neutral-600">Complete payment for your extension request.</p>
            </div>

            <!-- Payment Form -->
            <PaymentForm
                ReturnData="ReturnData"
                ExtensionType="ExtensionType"
                SubFunds="SubFunds"
                OnBack="HandleBackToRequest"
                OnContinue="HandleContinueToConfirmation" />
        }
    </div>
</div>
