@page "/unlock-request/{id}"
@layout MainLayout
@using blazor_wasm_ui.Components

<div class="bg-neutral-50 min-h-screen">
    <!-- Header -->
    <div class="bg-blue-600">
        <div class="max-w-7xl mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-4">
                    <div class="text-white">
                        <h1 class="text-lg text-white">Financial Authority Portal</h1>
                    </div>
                </div>
                <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 bg-white rounded-full flex items-center justify-center">
                        <span class="text-sm text-blue-500">JS</span>
                    </div>
                    <span class="text-white text-sm">John Smith</span>
                </div>
            </div>
        </div>
        <div class="bg-gray-50">
            <div class="max-w-7xl mx-auto px-6 py-6 pt-6 pr-6 pb-2 pl-6">
                <!-- Breadcrumb Navigation -->
                <Breadcrumb Items="BreadcrumbItems" OnItemClick="HandleBreadcrumbClick" />

                <!-- Back Button -->
                <button @onclick="HandleBack" class="flex items-center space-x-2 px-4 py-2 bg-white border border-gray-300 rounded-md text-sm text-gray-700 hover:bg-gray-50 hover:border-gray-400 transition-colors mb-6">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    <span>Back to Dashboard</span>
                </button>

                <!-- Page Title -->
                <h2 class="text-2xl text-gray-900 mb-6">Unlock Filing</h2>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="max-w-7xl mx-auto px-6 pt-4 pb-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Left Column - Main Form -->
            <div class="lg:col-span-2">
                <!-- Fund Summary -->
                <FundSummary
                    ReturnData="ReturnData"
                    ExtensionType="extensionType"
                    ExtensionTypeChanged="ExtensionTypeChanged"
                    WaiverReason="waiverReason"
                    WaiverReasonChanged="WaiverReasonChanged"
                    UnlockReason="UnlockReason"
                    UnlockReasonChanged="UnlockReasonChanged"
                    UnlockReasonOther="UnlockReasonOther"
                    UnlockReasonOtherChanged="UnlockReasonOtherChanged"
                    IsUnlockContext="true" />

                <!-- Request Form -->
                <div class="bg-white border border-gray-200 shadow-sm mb-6">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h3 class="text-lg text-gray-900">Details & Supporting Documents</h3>
                        <p class="text-sm text-gray-600 mt-1">Please upload all mandatory documents to proceed with your request.</p>
                    </div>

                    <div class="px-6 pt-4 pb-6 space-y-4">
                        <!-- Justification field - shown always, required only when "Other" is selected -->
                        <div>
                            <label class="block text-sm text-gray-600 mb-2">
                                <strong>Justification for Unlock Request</strong> @if (UnlockReason == "other") { <span class="text-red-500">*</span> }
                                <span class="ml-1 text-gray-400 cursor-help" title="Provide additional context or details about your unlock request. @(UnlockReason == "other" ? "Required when 'Other' is selected." : "Optional.")">
                                    <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                </span>
                            </label>
                            <textarea
                                class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-gray-900 focus:border-transparent resize-none bg-white"
                                rows="4"
                                placeholder="Please provide detailed justification for your unlock request, including any new circumstances or reasons that necessitate unlocking the filing at this time..."
                                @bind="UnlockJustification"
                                maxlength="1000"
                                required="@(UnlockReason == "other")">
                            </textarea>
                            <p class="text-xs text-gray-500 mt-1">@(UnlockJustification?.Length ?? 0)/1000 characters</p>
                        </div>

                        <!-- Additional Comments -->
                        <div class="px-0 py-2.5">
                            <label class="block text-sm text-gray-600 mb-2">
                                <strong>Additional Comments for Authority</strong> <span class="text-gray-500">(Optional)</span>
                            </label>
                            <textarea
                                class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-gray-900 focus:border-transparent resize-none bg-gray-50"
                                rows="4"
                                placeholder="Provide any additional context or information that may be relevant to your extension request..."
                                @bind="AdditionalComments"
                                maxlength="500">
                            </textarea>
                            <p class="text-xs text-gray-500 mt-1">@(AdditionalComments?.Length ?? 0)/500 characters</p>
                        </div>

                        <!-- Required Documentation -->
                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm text-gray-600 mb-2">
                                    <span class="flex items-center gap-1">
                                        <strong>Supporting Documentation</strong>
                                        <span class="text-gray-400 cursor-help" title="Upload any documentation that may help to support your request to unlock a filing row. This may include correspondence, legal documents, or other relevant materials.">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                            </svg>
                                        </span>
                                    </span>
                                </label>
                                <div class="border-2 border-dashed border-gray-300 rounded-lg p-8 hover:border-gray-400 transition-colors text-center relative">
                                    <input
                                        type="file"
                                        accept=".pdf,.doc,.docx"
                                        multiple
                                        @onchange="HandleFileUpload"
                                        class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
                                    <svg class="w-8 h-8 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                                    </svg>
                                    <p class="text-sm text-gray-700 mb-1">
                                        Drag and drop your supporting documents here, or click to browse
                                    </p>
                                    <p class="text-xs text-gray-500">
                                        Supported formats: PDF, DOC, DOCX (Max 10MB)
                                    </p>
                                </div>
                                @if (SupportingDocuments != null && SupportingDocuments.Any())
                                {
                                    <div class="mt-3 space-y-2">
                                        @foreach (var file in SupportingDocuments)
                                        {
                                            <div class="flex items-center justify-between bg-green-50 border border-green-200 rounded-md px-3 py-2">
                                                <span class="text-sm text-green-700">✓ @file.Name</span>
                                                <button @onclick="() => RemoveDocument(file)" class="text-red-600 hover:text-red-800 transition-colors" type="button">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                                    </svg>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex justify-between items-center">
                    <button @onclick="HandleBack" class="px-6 py-2 border border-gray-300 rounded-md text-sm text-gray-700 hover:bg-gray-50 hover:border-gray-400 transition-colors">
                        Cancel
                    </button>

                    <button @onclick="HandleShowConfirmDialog"
                            disabled="@(!CanSubmit || IsSubmitting)"
                            class="px-6 py-2 bg-red-600 hover:bg-red-700 text-white rounded-md disabled:opacity-50 disabled:cursor-not-allowed">
                        @(IsSubmitting ? "Submitting Request..." : "Submit Unlock Request")
                    </button>
                </div>
            </div>

            <!-- Right Column - Contact Information and Support -->
            <div class="lg:col-span-1 space-y-6">
                <!-- Contact Information -->
                <div class="bg-white border border-gray-200 rounded-lg p-6">
                    <h3 class="text-lg text-gray-900 mb-4">Contact</h3>
                    <div class="space-y-3">
                        <div>
                            <p class="text-gray-600">Fund Manager</p>
                            <p class="text-gray-900">Sarah Johnson</p>
                        </div>
                        <div>
                            <p class="text-gray-600">Email</p>
                            <p class="text-gray-900">sarah.johnson@@financialfirm.com</p>
                        </div>
                        <div>
                            <p class="text-gray-600">Phone</p>
                            <p class="text-gray-900">+1 (555) 123-4567</p>
                        </div>
                    </div>
                </div>

                <!-- Contact Support -->
                <ContactSupport />
            </div>
        </div>
    </div>

    <!-- Confirmation Dialog -->
    @if (ShowConfirmDialog)
    {
        <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div class="bg-white rounded-lg p-6 max-w-md w-full mx-4">
                <div class="flex items-center mb-4">
                    <svg class="w-6 h-6 text-yellow-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                    </svg>
                    <h3 class="text-lg font-semibold text-gray-900">Confirm Unlock Request</h3>
                </div>
                <p class="text-gray-600 mb-6">
                    Are you sure you want to submit this unlock request? This action cannot be undone.
                </p>
                <div class="flex justify-end space-x-3">
                    <button @onclick="() => ShowConfirmDialog = false" class="px-4 py-2 border border-gray-300 rounded-md text-sm text-gray-700 hover:bg-gray-50">
                        Cancel
                    </button>
                    <button @onclick="HandleConfirmSubmit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-md">
                        Submit
                    </button>
                </div>
            </div>
        </div>
    }
</div>
