@page "/confirmation"
@layout MainLayout
@using Microsoft.AspNetCore.Components.Forms
@using blazor_wasm_ui.Models
@using blazor_wasm_ui.Services

<section class="confirmation-page-section">
    <!-- Success Header -->
    <div class="text-center mb-8">
        <h1 class="text-3xl text-neutral-900 mb-2 flex items-center justify-center gap-3">
            <svg class="w-8 h-8 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            Extension Request Submitted Successfully!
        </h1>
        <p class="text-neutral-600 max-w-2xl mx-auto">
            Your extension request has been received and payment has been processed.
            You will receive an email confirmation shortly with the updated filing dates.
        </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Request Confirmation -->
            <div class="bg-white border border-neutral-200 rounded-lg">
                <div class="px-6 py-4 border-b border-neutral-200">
                    <h2 class="text-lg font-medium text-neutral-900">Request Confirmation</h2>
                </div>
                <div class="p-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-4">
                            <div>
                                <div class="text-sm text-neutral-700">Reference Number</div>
                                <div class="text-neutral-900 font-mono">@ReferenceNumber</div>
                            </div>
                            <div>
                                <div class="text-sm text-neutral-700">Fund Name</div>
                                <div class="text-neutral-900">@ReturnData.FundName</div>
                            </div>
                            <div>
                                <div class="text-sm text-neutral-700">Return ID</div>
                                <div class="text-neutral-900">RET-2024-@ReturnData.Id.PadLeft(6, '0')</div>
                            </div>
                            <div>
                                <div class="text-sm text-neutral-700">Reporting Period</div>
                                <div class="text-neutral-900">@ReturnData.PeriodDescription</div>
                            </div>
                        </div>
                        <div class="space-y-4">
                            <div>
                                <div class="text-sm text-neutral-700">Submitted On</div>
                                <div class="text-neutral-900">@FormatTimestamp(DateTime.Now)</div>
                            </div>
                            <div>
                                <div class="text-sm text-neutral-700">Status</div>
                                <div class="inline-flex items-center px-2 py-1 rounded-full text-xs bg-green-100 text-green-800">
                                    Submitted
                                </div>
                            </div>
                            <div>
                                <div class="text-sm text-neutral-700">Original Due Date</div>
                                <div class="text-neutral-900">@ReturnData.DueDate</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Extension Details -->
            <div class="bg-white border border-neutral-200 rounded-lg">
                <div class="px-6 py-4 border-b border-neutral-200">
                    <h2 class="text-lg font-medium text-neutral-900">Extension Details</h2>
                </div>
                <div class="p-6">
                    @if (!IsMultiFund)
                    {
                        <div class="space-y-4">
                            <div class="flex justify-between items-center">
                                <div>
                                    <div class="text-sm text-neutral-700">Extension Type</div>
                                    <div class="text-neutral-900">@GetExtensionTypeDisplay(ExtensionType)</div>
                                </div>
                                <div class="text-right">
                                    <div class="text-sm text-neutral-700">New Filing Date</div>
                                    <div class="text-neutral-900">@GetNewFilingDate(ExtensionType)</div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-4">
                            <div class="text-sm text-neutral-700 mb-4">Sub-Fund Extensions:</div>
                            @if (SubFunds != null)
                            {
                                @foreach (var subFund in SubFunds.Where(sf => !string.IsNullOrEmpty(sf.ExtensionType) && sf.ExtensionType != "none"))
                                {
                                    <div class="flex justify-between items-center py-3 border-b border-neutral-200 last:border-b-0">
                                        <div>
                                            <div class="text-sm text-neutral-900">@subFund.Name</div>
                                            <div class="text-xs text-neutral-600">@GetExtensionTypeDisplay(subFund.ExtensionType)</div>
                                        </div>
                                        <div class="text-right">
                                            <div class="text-sm text-neutral-900">@GetNewFilingDate(subFund.ExtensionType)</div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Payment Confirmation -->
            @if (!IsDeferralRequest && PaymentData != null)
            {
                <div class="bg-white border border-neutral-200 rounded-lg">
                    <div class="px-6 py-4 border-b border-neutral-200">
                        <h2 class="text-lg font-medium text-neutral-900">Payment Confirmation</h2>
                    </div>
                    <div class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-4">
                                <div>
                                    <div class="text-sm text-neutral-700">Transaction ID</div>
                                    <div class="text-neutral-900 font-mono">@GetTransactionId()</div>
                                </div>
                                <div>
                                    <div class="text-sm text-neutral-700">Payment Method</div>
                                    <div class="text-neutral-900">@GetPaymentMethodDisplay()</div>
                                </div>
                            </div>
                            <div class="space-y-4">
                                <div>
                                    <div class="text-sm text-neutral-700">Amount Paid</div>
                                    <div class="text-neutral-900">@FormatCurrency(PaymentData.TotalAmount)</div>
                                </div>
                                <div>
                                    <div class="text-sm text-neutral-700">Payment Status</div>
                                    <div class="inline-flex items-center px-2 py-1 rounded-full text-xs @GetPaymentStatusClass()">
                                        @GetPaymentStatus()
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Next Steps -->
            <div class="bg-white border border-neutral-200 rounded-lg">
                <div class="px-6 py-4 border-b border-neutral-200">
                    <h2 class="text-lg font-medium text-neutral-900">Next Steps</h2>
                </div>
                <div class="p-6">
                    <div class="space-y-4">
                        <div class="flex items-start space-x-3">
                            <div class="flex items-center justify-center w-6 h-6 bg-neutral-100 rounded-full text-xs text-neutral-600 mt-1">
                                1
                            </div>
                            <div>
                                <div class="text-sm text-neutral-900">Email Confirmation</div>
                                <div class="text-xs text-neutral-600">
                                    You will receive an email confirmation within 30 minutes with your updated filing dates.
                                </div>
                            </div>
                        </div>
                        <div class="flex items-start space-x-3">
                            <div class="flex items-center justify-center w-6 h-6 bg-neutral-100 rounded-full text-xs text-neutral-600 mt-1">
                                2
                            </div>
                            <div>
                                <div class="text-sm text-neutral-900">Final Approval</div>
                                <div class="text-xs text-neutral-600">
                                    Once approved, your new filing dates will be officially updated in the system.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 justify-between">
                <div class="flex gap-3">
                    <button type="button"
                            @onclick="HandleDownloadReceipt"
                            class="px-6 py-2 text-sm font-medium text-neutral-700 bg-white border border-neutral-300 rounded-md hover:bg-neutral-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-neutral-500">
                        <svg class="w-4 h-4 mr-2 inline" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                        </svg>
                        Download Receipt
                    </button>
                    <button type="button"
                            class="px-6 py-2 text-sm font-medium text-neutral-700 bg-white border border-neutral-300 rounded-md hover:bg-neutral-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-neutral-500">
                        <svg class="w-4 h-4 mr-2 inline" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"></path>
                        </svg>
                        View Documents
                    </button>
                </div>
                <button type="button"
                        @onclick="OnBackToDashboard"
                        class="px-8 py-2 text-sm font-medium text-white bg-neutral-900 border border-transparent rounded-md hover:bg-neutral-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-neutral-500">
                    <svg class="w-4 h-4 mr-2 inline" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.707 2.293a1 1 0 00-1.414 0l-8 8a1 1 0 001.414 1.414L9 4.414V17a1 1 0 102 0V4.414l6.293 6.293a1 1 0 001.414-1.414l-8-8z"></path>
                    </svg>
                    Back to Dashboard
                </button>
            </div>
        </div>

        <!-- Right Sidebar -->
        <div class="lg:col-span-1">
            <div class="bg-white border border-neutral-200 rounded-lg mb-6">
                <div class="px-6 py-4 border-b border-neutral-200">
                    <h3 class="text-lg font-medium text-neutral-900">Important Information</h3>
                </div>
                <div class="p-6">
                    <div class="space-y-4 text-sm text-neutral-600">
                        <div class="flex items-start space-x-2">
                            <svg class="w-4 h-4 text-neutral-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
                            </svg>
                            <span>New filing dates are provisional until final approval</span>
                        </div>
                        <div class="flex items-start space-x-2">
                            <svg class="w-4 h-4 text-neutral-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"></path>
                            </svg>
                            <span>Keep your reference number for future correspondence</span>
                        </div>
                        <div class="flex items-start space-x-2">
                            <svg class="w-4 h-4 text-neutral-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z"></path>
                            </svg>
                            <span>Extension fees are non-refundable once processed</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white border border-neutral-200 rounded-lg">
                <div class="p-6">
                    <div class="text-center">
                        <h3 class="text-sm font-medium text-neutral-900 mb-2">Need Help?</h3>
                        <p class="text-xs text-neutral-600 mb-4">
                            Contact our support team if you have questions about your extension request.
                        </p>
                        <div class="space-y-2">
                            <button type="button"
                                    class="w-full px-4 py-2 text-sm font-medium text-neutral-700 bg-white border border-neutral-300 rounded-md hover:bg-neutral-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-neutral-500">
                                Contact Support
                            </button>
                            <div class="text-xs text-neutral-500">
                                support@cima.ky | +1 (345) 949-7089
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    [Inject]
    public IConfigurationService ConfigurationService { get; set; } = null!;

    [Parameter]
    public FinancialReturn ReturnData { get; set; } = null!;

    [Parameter]
    public string ExtensionType { get; set; } = string.Empty;

    [Parameter]
    public List<SubFund>? SubFunds { get; set; }

    [Parameter]
    public PaymentData? PaymentData { get; set; }

    [Parameter]
    public EventCallback OnBackToDashboard { get; set; }

    private string ReferenceNumber => $"EXT-{DateTime.Now:yyyyMMddHHmmss}";
    private bool IsMultiFund => ReturnData.FundType == FundType.MutualFund && ReturnData.FundStructure == FundStructure.MultiFund;
    private bool IsDeferralRequest => ExtensionType == "deferral";

    private string GetNewFilingDate(string extensionType)
    {
        var baseDate = new DateTime(2025, 4, 30);
        return extensionType switch
        {
            "1-month" => baseDate.AddMonths(1).ToString("MMMM d, yyyy"),
            "2-month" => baseDate.AddMonths(2).ToString("MMMM d, yyyy"),
            "3-month" => baseDate.AddMonths(3).ToString("MMMM d, yyyy"),
            "deferral" => baseDate.AddMonths(6).ToString("MMMM d, yyyy"),
            _ => ReturnData.DueDate
        };
    }

    private string GetExtensionTypeDisplay(string extensionType)
    {
        return extensionType switch
        {
            "1-month" => "1 Month Extension (30 days)",
            "2-month" => "2 Month Extension (60 days)",
            "3-month" => "3 Month Extension (90 days)",
            "waiver" => "Request Waiver",
            "deferral" => "Deferral (6 months)",
            _ => "No Extension"
        };
    }

    private string GetPaymentMethodDisplay()
    {
        if (PaymentData == null) return "N/A";

        var method = PaymentData.PaymentMethod switch
        {
            PaymentMethod.Card => "Card Payment",
            PaymentMethod.WireTransfer => "Wire Transfer",
            PaymentMethod.BankTransfer => "Bank Transfer",
            PaymentMethod.Escrow => "Escrow",
            _ => "Unknown"
        };

        if (PaymentData.PaymentMethod == PaymentMethod.Card && !string.IsNullOrEmpty(PaymentData.CardNumber))
        {
            var lastFour = PaymentData.CardNumber.Length >= 4
                ? PaymentData.CardNumber[^4..]
                : PaymentData.CardNumber;
            method += $" (**** **** **** {lastFour})";
        }

        return method;
    }

    private string GetPaymentStatus()
    {
        if (PaymentData == null) return "N/A";

        return PaymentData.PaymentMethod == PaymentMethod.Escrow ? "Completed" : "Pending Review";
    }

    private string GetTransactionId()
    {
        if (PaymentData == null) return "N/A";

        return PaymentData.PaymentMethod switch
        {
            PaymentMethod.Card => $"CARD-{DateTime.Now:yyyyMMddHHmmss}",
            PaymentMethod.WireTransfer => PaymentData.TransferReference ?? $"WIRE-{DateTime.Now:yyyyMMddHHmmss}",
            PaymentMethod.BankTransfer => PaymentData.TransferReference ?? $"BANK-{DateTime.Now:yyyyMMddHHmmss}",
            PaymentMethod.Escrow => PaymentData.EscrowAccountNumber ?? $"ESCR-{DateTime.Now:yyyyMMddHHmmss}",
            _ => $"TXN-{DateTime.Now:yyyyMMddHHmmss}"
        };
    }

    private string FormatCurrency(decimal amount)
    {
        return $"{amount:N2} CI$";
    }

    private string FormatTimestamp(DateTime timestamp)
    {
        return timestamp.ToString("MMMM d, yyyy 'at' h:mm tt");
    }

    private async Task HandleDownloadReceipt()
    {
        // In a real implementation, this would generate and download a PDF
        // For now, just show an alert
        await Task.CompletedTask;
    }

    private string GetPaymentStatusClass()
    {
        if (PaymentData == null) return "bg-gray-100 text-gray-800";

        return PaymentData.PaymentMethod == PaymentMethod.Escrow
            ? "bg-green-100 text-green-800"
            : "bg-orange-100 text-orange-800";
    }
}
