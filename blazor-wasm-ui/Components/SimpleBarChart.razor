<div class="w-full h-full flex items-end justify-between space-x-2 p-4">
    @foreach (var data in GetBarChartData())
    {
        <div class="flex-1 flex flex-col items-center">
            <div class="w-full bg-gray-200 rounded-t relative" style="height: 200px;">
                <!-- Approved bar -->
                <div
                    class="bg-green-500 absolute bottom-0 w-full rounded-t transition-all duration-300"
                    style="height: @(data.Approved * 2)px;">
                </div>
                <!-- Denied bar (stacked on top) -->
                <div
                    class="bg-red-500 absolute bottom-0 w-full transition-all duration-300"
                    style="height: @(data.Denied * 2)px; bottom: @(data.Approved * 2)px;">
                </div>
            </div>
            <span class="text-xs text-gray-600 mt-2">@data.Month</span>
            <div class="text-xs text-center mt-1">
                <div class="text-green-600">@data.Approved approved</div>
                <div class="text-red-600">@data.Denied denied</div>
            </div>
        </div>
    }
</div>

<div class="flex justify-center space-x-6 mt-4">
    <div class="flex items-center">
        <div class="w-3 h-3 bg-green-500 rounded mr-2"></div>
        <span class="text-sm text-gray-600">Approved</span>
    </div>
    <div class="flex items-center">
        <div class="w-3 h-3 bg-red-500 rounded mr-2"></div>
        <span class="text-sm text-gray-600">Denied</span>
    </div>
</div>

@code {
    private class BarChartData
    {
        public string Month { get; set; } = "";
        public int Approved { get; set; }
        public int Denied { get; set; }
    }

    private List<BarChartData> GetBarChartData()
    {
        return new List<BarChartData>
        {
            new BarChartData { Month = "Jan", Approved = 10, Denied = 2 },
            new BarChartData { Month = "Feb", Approved = 13, Denied = 2 },
            new BarChartData { Month = "Mar", Approved = 16, Denied = 2 },
            new BarChartData { Month = "Apr", Approved = 19, Denied = 3 },
            new BarChartData { Month = "May", Approved = 14, Denied = 2 },
            new BarChartData { Month = "Jun", Approved = 18, Denied = 2 }
        };
    }
}