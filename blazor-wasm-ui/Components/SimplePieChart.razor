<div class="relative w-48 h-48 mx-auto">
    <svg viewBox="0 0 100 100" class="w-full h-full">
        @for (int i = 0; i < GetPieChartData().Count; i++)
        {
            var data = GetPieChartData()[i];
            var startAngle = i == 0 ? 0 : GetPieChartData().Take(i).Sum(d => d.Value) * 3.6;
            var endAngle = (data.Value * 3.6) + startAngle;

            <path
                d="@GetPieSlicePath(startAngle, endAngle)"
                fill="@data.Color"
                stroke="white"
                stroke-width="0.5">
            </path>
        }
    </svg>

    <!-- Center text -->
    <div class="absolute inset-0 flex items-center justify-center">
        <div class="text-center">
            <div class="text-2xl font-bold text-gray-900">@GetTotalValue()</div>
            <div class="text-sm text-gray-600">Total</div>
        </div>
    </div>
</div>

<div class="flex flex-wrap justify-center gap-4 mt-4">
    @foreach (var data in GetPieChartData())
    {
        <div class="flex items-center">
            <div class="w-3 h-3 rounded mr-2" style="background-color: @data.Color;"></div>
            <span class="text-sm text-gray-600">@data.Name: @data.Value</span>
        </div>
    }
</div>

@code {
    private class PieChartData
    {
        public string Name { get; set; } = "";
        public int Value { get; set; }
        public string Color { get; set; } = "";
    }

    private List<PieChartData> GetPieChartData()
    {
        return new List<PieChartData>
        {
            new PieChartData { Name = "Approved", Value = 90, Color = "#10b981" },
            new PieChartData { Name = "Denied", Value = 13, Color = "#ef4444" },
            new PieChartData { Name = "Partially Approved", Value = 8, Color = "#f59e0b" }
        };
    }

    private int GetTotalValue()
    {
        return GetPieChartData().Sum(d => d.Value);
    }

    private string GetPieSlicePath(double startAngle, double endAngle)
    {
        var startAngleRad = (startAngle - 90) * Math.PI / 180;
        var endAngleRad = (endAngle - 90) * Math.PI / 180;

        var x1 = 50 + 40 * Math.Cos(startAngleRad);
        var y1 = 50 + 40 * Math.Sin(startAngleRad);
        var x2 = 50 + 40 * Math.Cos(endAngleRad);
        var y2 = 50 + 40 * Math.Sin(endAngleRad);

        var largeArcFlag = endAngle - startAngle > 180 ? 1 : 0;

        return $"M 50 50 L {x1} {y1} A 40 40 0 {largeArcFlag} 1 {x2} {y2} Z";
    }
}