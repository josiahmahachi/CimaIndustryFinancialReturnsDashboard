@using Microsoft.AspNetCore.Components.Forms
@using blazor_wasm_ui.Models

<section class="document-upload-section space-y-6">
    <!-- Error Alert -->
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
            <strong>Error:</strong> @ErrorMessage
        </div>
    }

    <!-- Info Alert: Document Requirements -->
    @if (ShowDocumentRequirementsInfo && DocumentRequirements != null)
    {
        <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg text-blue-700 text-sm">
            <strong>Required Documents:</strong>
            <ul class="list-disc list-inside mt-2">
                @foreach (var doc in DocumentRequirements.GetRequiredDocuments())
                {
                    <li>@doc</li>
                }
            </ul>
        </div>
    }

    <!-- Cover Letter -->
    <div class="document-group">
        <label for="cover-letter" class="block text-sm font-medium text-neutral-900 mb-2">
            Cover Letter <span class="text-red-600">*</span>
        </label>
        <div class="file-input-wrapper border-2 border-dashed border-neutral-300 rounded-lg p-4 bg-neutral-50 hover:bg-neutral-100 transition-colors">
            <InputFile 
                id="cover-letter"
                OnChange="HandleCoverLetterChange"
                class="block w-full cursor-pointer"
                accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.tiff,.txt" />
            @if (CoverLetter != null)
            {
                <div class="mt-2 p-2 bg-green-50 border border-green-200 rounded text-sm text-green-700 flex items-center justify-between">
                    <span>✓ @CoverLetter.Name (@FormatBytes(CoverLetter.Size))</span>
                    <button type="button" @onclick="RemoveCoverLetter" class="text-red-600 hover:text-red-800">✕</button>
                </div>
            }
            else if (!string.IsNullOrEmpty(CoverLetterError))
            {
                <div class="mt-2 p-2 bg-red-50 border border-red-200 rounded text-sm text-red-700">
                    ✕ @CoverLetterError
                </div>
            }
        </div>
        <p class="text-xs text-neutral-600 mt-1">Required for all requests. Max 10 MB.</p>
    </div>

    <!-- Auditor Letter -->
    @if (IsAuditorLetterRequired())
    {
        <div class="document-group">
            <label for="auditor-letter" class="block text-sm font-medium text-neutral-900 mb-2">
                Auditor Letter <span class="text-red-600">*</span>
            </label>
            <div class="file-input-wrapper border-2 border-dashed border-neutral-300 rounded-lg p-4 bg-neutral-50 hover:bg-neutral-100 transition-colors">
                <InputFile 
                    id="auditor-letter"
                    OnChange="HandleAuditorLetterChange"
                    class="block w-full cursor-pointer"
                    accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.tiff,.txt" />
                @if (AuditorLetter != null)
                {
                    <div class="mt-2 p-2 bg-green-50 border border-green-200 rounded text-sm text-green-700 flex items-center justify-between">
                        <span>✓ @AuditorLetter.Name (@FormatBytes(AuditorLetter.Size))</span>
                        <button type="button" @onclick="RemoveAuditorLetter" class="text-red-600 hover:text-red-800">✕</button>
                    </div>
                }
                else if (!string.IsNullOrEmpty(AuditorLetterError))
                {
                    <div class="mt-2 p-2 bg-red-50 border border-red-200 rounded text-sm text-red-700">
                        ✕ @AuditorLetterError
                    </div>
                }
            </div>
            <p class="text-xs text-neutral-600 mt-1">Required for 2-month or 3-month extensions</p>
        </div>
    }

    <!-- Operator Affidavit -->
    @if (IsOperatorAffidavitRequired())
    {
        <div class="document-group">
            <label for="operator-affidavit" class="block text-sm font-medium text-neutral-900 mb-2">
                Operator Affidavit <span class="text-red-600">*</span>
            </label>
            <div class="file-input-wrapper border-2 border-dashed border-neutral-300 rounded-lg p-4 bg-neutral-50 hover:bg-neutral-100 transition-colors">
                <InputFile 
                    id="operator-affidavit"
                    OnChange="HandleOperatorAffidavitChange"
                    class="block w-full cursor-pointer"
                    accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.tiff,.txt" />
                @if (OperatorAffidavit != null)
                {
                    <div class="mt-2 p-2 bg-green-50 border border-green-200 rounded text-sm text-green-700 flex items-center justify-between">
                        <span>✓ @OperatorAffidavit.Name (@FormatBytes(OperatorAffidavit.Size))</span>
                        <button type="button" @onclick="RemoveOperatorAffidavit" class="text-red-600 hover:text-red-800">✕</button>
                    </div>
                }
                else if (!string.IsNullOrEmpty(OperatorAffidavitError))
                {
                    <div class="mt-2 p-2 bg-red-50 border border-red-200 rounded text-sm text-red-700">
                        ✕ @OperatorAffidavitError
                    </div>
                }
            </div>
            <p class="text-xs text-neutral-600 mt-1">Required for waiver requests with specific reasons</p>
        </div>
    }

    <!-- Administrator Letter -->
    @if (IsAdministratorLetterRequired())
    {
        <div class="document-group">
            <label for="administrator-letter" class="block text-sm font-medium text-neutral-900 mb-2">
                Administrator Letter <span class="text-red-600">*</span>
            </label>
            <div class="file-input-wrapper border-2 border-dashed border-neutral-300 rounded-lg p-4 bg-neutral-50 hover:bg-neutral-100 transition-colors">
                <InputFile 
                    id="administrator-letter"
                    OnChange="HandleAdministratorLetterChange"
                    class="block w-full cursor-pointer"
                    accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.tiff,.txt" />
                @if (AdministratorLetter != null)
                {
                    <div class="mt-2 p-2 bg-green-50 border border-green-200 rounded text-sm text-green-700 flex items-center justify-between">
                        <span>✓ @AdministratorLetter.Name (@FormatBytes(AdministratorLetter.Size))</span>
                        <button type="button" @onclick="RemoveAdministratorLetter" class="text-red-600 hover:text-red-800">✕</button>
                    </div>
                }
                else if (!string.IsNullOrEmpty(AdministratorLetterError))
                {
                    <div class="mt-2 p-2 bg-red-50 border border-red-200 rounded text-sm text-red-700">
                        ✕ @AdministratorLetterError
                    </div>
                }
            </div>
            <p class="text-xs text-neutral-600 mt-1">Required for deregistered funds</p>
        </div>
    }

    <!-- Liquidator Report -->
    @if (IsLiquidatorReportRequired())
    {
        <div class="document-group">
            <label for="liquidator-report" class="block text-sm font-medium text-neutral-900 mb-2">
                Liquidator Report <span class="text-red-600">*</span>
            </label>
            <div class="file-input-wrapper border-2 border-dashed border-neutral-300 rounded-lg p-4 bg-neutral-50 hover:bg-neutral-100 transition-colors">
                <InputFile 
                    id="liquidator-report"
                    OnChange="HandleLiquidatorReportChange"
                    class="block w-full cursor-pointer"
                    accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.tiff,.txt" />
                @if (LiquidatorReport != null)
                {
                    <div class="mt-2 p-2 bg-green-50 border border-green-200 rounded text-sm text-green-700 flex items-center justify-between">
                        <span>✓ @LiquidatorReport.Name (@FormatBytes(LiquidatorReport.Size))</span>
                        <button type="button" @onclick="RemoveLiquidatorReport" class="text-red-600 hover:text-red-800">✕</button>
                    </div>
                }
                else if (!string.IsNullOrEmpty(LiquidatorReportError))
                {
                    <div class="mt-2 p-2 bg-red-50 border border-red-200 rounded text-sm text-red-700">
                        ✕ @LiquidatorReportError
                    </div>
                }
            </div>
            <p class="text-xs text-neutral-600 mt-1">Required for liquidated funds</p>
        </div>
    }

    <!-- Other Documents (Optional) -->
    <div class="document-group">
        <label for="other-documents" class="block text-sm font-medium text-neutral-900 mb-2">
            Other Documents <span class="text-neutral-500">(Optional)</span>
        </label>
        <div class="file-input-wrapper border-2 border-dashed border-neutral-300 rounded-lg p-4 bg-neutral-50 hover:bg-neutral-100 transition-colors">
            <InputFile 
                id="other-documents"
                OnChange="HandleOtherDocumentsChange"
                class="block w-full cursor-pointer"
                accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.tiff,.txt" />
            @if (OtherDocuments != null)
            {
                <div class="mt-2 p-2 bg-green-50 border border-green-200 rounded text-sm text-green-700 flex items-center justify-between">
                    <span>✓ @OtherDocuments.Name (@FormatBytes(OtherDocuments.Size))</span>
                    <button type="button" @onclick="RemoveOtherDocuments" class="text-red-600 hover:text-red-800">✕</button>
                </div>
            }
            else if (!string.IsNullOrEmpty(OtherDocumentsError))
            {
                <div class="mt-2 p-2 bg-red-50 border border-red-200 rounded text-sm text-red-700">
                    ✕ @OtherDocumentsError
                </div>
            }
        </div>
        <p class="text-xs text-neutral-600 mt-1">Any additional supporting documents. Allowed formats: PDF, DOC, DOCX, XLS, XLSX, JPG, PNG, TIFF, TXT</p>
    </div>

    <!-- Additional Comments -->
    <div class="document-group">
        <label for="additional-comments" class="block text-sm font-medium text-neutral-900 mb-2">
            Additional Comments <span class="text-neutral-500">(Optional)</span>
        </label>
        <textarea 
            id="additional-comments"
            @bind="AdditionalComments"
            @bind:event="oninput"
            placeholder="Enter any additional comments or explanations..."
            class="w-full px-3 py-2 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            rows="4">
        </textarea>
        <p class="text-xs text-neutral-600 mt-1">@AdditionalComments.Length / 5000 characters</p>
    </div>
</section>
