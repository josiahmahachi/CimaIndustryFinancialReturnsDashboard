@using Microsoft.AspNetCore.Components

<div class="flex items-center space-x-2">
    <input
        type="radio"
        value="@Value"
        name="@GroupName"
        checked="@(GroupValue == Value)"
        @onchange="OnCheckedChanged"
        class="h-4 w-4 border-gray-300 text-blue-600 focus:ring-blue-500 focus:ring-2 @Class"
        id="@Id"
        disabled="@Disabled"
        @attributes="AdditionalAttributes" />
    <label for="@Id" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
        @ChildContent
    </label>
</div>

@code {
    [CascadingParameter] public RadioGroup? RadioGroup { get; set; }

    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object?>? AdditionalAttributes { get; set; }

    private string GroupName => RadioGroup?.GetHashCode().ToString() ?? "";
    private string GroupValue => RadioGroup?.Value ?? "";

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(Id))
        {
            Id = Guid.NewGuid().ToString();
        }
    }

    private async Task OnCheckedChanged(ChangeEventArgs e)
    {
        if (RadioGroup != null)
        {
            await RadioGroup.ValueChanged.InvokeAsync(Value);
        }
    }
}